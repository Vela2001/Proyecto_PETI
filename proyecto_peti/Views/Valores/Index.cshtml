@model List<proyecto_peti.Models.Valores>

@{
    ViewBag.Title = "3. VALORES";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
    }

    h2.text-center {
        background: linear-gradient(135deg, #3f51b5, #2196f3);
        color: white;
        padding: 1rem;
        margin: -1.5rem -1.5rem 2rem -1.5rem;
        font-weight: 700;
        letter-spacing: 1px;
        box-shadow: 0 4px 12px rgba(33, 150, 243, 0.2);
    }

    .bg-light {
        background-color: #f1f8fe !important;
        border-left: 4px solid #2196f3;
        border-radius: 8px;
    }

    .form-control {
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        border: 1px solid #ced4da;
        transition: all 0.3s;
        width: 100%;
        height: 60px;
    }

        .form-control:focus {
            border-color: #2196f3;
            box-shadow: 0 0 0 0.2rem rgba(33, 150, 243, 0.25);
        }

    .btn {
        font-weight: 600;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: all 0.3s;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
    }

    .btn-primary {
        background-color: #2196f3;
        border-color: #2196f3;
    }

    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

    ul {
        padding-left: 1.5rem;
    }

        ul li {
            margin-bottom: 0.5rem;
            position: relative;
        }

    strong {
        color: #3f51b5;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .fw-bold {
        font-weight: 600 !important;
    }

    .border {
        border: 1px solid #dee2e6 !important;
    }

    .rounded {
        border-radius: 8px !important;
    }

    .p-3 {
        padding: 1rem !important;
    }

    .mb-4 {
        margin-bottom: 1.5rem !important;
    }

    .mt-4 {
        margin-top: 1.5rem !important;
    }

    .py-2 {
        padding-top: 0.5rem !important;
        padding-bottom: 0.5rem !important;
    }

    .mb-3 {
        margin-bottom: 1rem !important;
    }

    .text-center {
        text-align: center !important;
    }

    .d-flex {
        display: flex !important;
    }

    .justify-content-between {
        justify-content: space-between !important;
    }
</style>

<div class="container mt-4">
    <div class="card p-4">
        <h2 class="text-center mb-4">3. VALORES</h2>
        <div style="text-align: center;">
            <img src="~/Content/img/valores.jpg" alt="Visión empresarial" style="width: 100%; max-width: 700px; border-radius: 12px; margin-top: 2rem;" />
        </div>

        <p class="lead">
            Los <strong>VALORES</strong> de tu empresa son los principios fundamentales que guían cada decisión y acción.
            Representan <strong>lo que realmente importa</strong> en tu organización y deben ser vividos por todos los miembros del equipo.
        </p>

        <div class="alert alert-primary" style="background-color: #e3f2fd; border-left: 4px solid #2196f3;">
            <h5 class="fw-bold mb-3">📌 Características de buenos valores corporativos:</h5>
            <ul class="mb-0">
                <li>Deben ser <strong>auténticos</strong> y reflejar la verdadera cultura</li>
                <li><strong>Perdurables</strong> en el tiempo (no cambian frecuentemente)</li>
                <li><strong>Claros y comprensibles</strong> por todos</li>
            </ul>
        </div>

        <div class="bg-light p-4 rounded mb-4">
            <h5 class="fw-bold text-primary mb-3">💡 EJEMPLOS INSPIRADORES</h5>

            <div class="mb-3 p-3 bg-white rounded">
                <strong class="text-info">Empresa tecnológica:</strong>
                <ul class="mb-0">
                    <li>Innovación disruptiva</li>
                    <li>Colaboración sin barreras</li>
                    <li>Pasión por el impacto</li>
                </ul>
            </div>

            <div class="mb-3 p-3 bg-white rounded">
                <strong class="text-info">Empresa de servicios:</strong>
                <ul class="mb-0">
                    <li>Excelencia en cada interacción</li>
                    <li>Integridad absoluta</li>
                    <li>Orientación al cliente</li>
                </ul>
            </div>

            <div class="p-3 bg-white rounded">
                <strong class="text-info">Organización sin fines de lucro:</strong>
                <ul class="mb-0">
                    <li>Compromiso con la comunidad</li>
                    <li>Transparencia en todas nuestras acciones</li>
                    <li>Sostenibilidad a largo plazo</li>
                </ul>
            </div>
        </div>

        @using (Html.BeginForm("CreateOrEdit", "Valores", FormMethod.Post))
        {
            <div class="bg-white p-4 rounded border mb-4">
                <h5 class="text-center text-primary mb-4">✨ DEFINE LOS VALORES FUNDAMENTALES DE TU EMPRESA</h5>

                <div id="valoresContainer">
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <div class="mb-4">
                            @Html.HiddenFor(m => m[i].Id)
                            @Html.HiddenFor(m => m[i].PlanId)
                            <input type="text" name="model[@i].Valor" class="form-control"
                                   placeholder="Escribe aquí tu Valor @(i + 1) (Ejemplo: 'Integridad', 'Innovación', 'Excelencia')"
                                   value="@(Model[i].Valor)" />
                        </div>
                    }
                </div>

                <div class="text-center mb-4">
                    <button type="button" id="agregarValor" class="btn btn-outline-primary">
                        + Agregar más valores
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Index", "Vision")" class="btn btn-secondary">← 2. VISIÓN</a>
                <button type="submit" class="btn btn-success">GUARDAR VALORES</button>
                <a href="@Url.Action("Index", "Objetivos")" class="btn btn-primary">4. OBJETIVOS →</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
    let index = @Model.Count;

    document.getElementById("agregarValor").addEventListener("click", function () {
        const container = document.getElementById("valoresContainer");

        const div = document.createElement("div");
        div.className = "mb-4";
        div.innerHTML = `
            <input type="hidden" name="model[${index}].Id" value="0" />
            <input type="hidden" name="model[${index}].PlanId" value="@Model.FirstOrDefault()?.PlanId" />
            <input type="text" name="model[${index}].Valor" class="form-control"
                placeholder="Escribe aquí tu Valor ${(index + 1)} (Ejemplo: 'Responsabilidad', 'Liderazgo')" />
        `;

        container.appendChild(div);
        index++;
    });
    </script>
}
