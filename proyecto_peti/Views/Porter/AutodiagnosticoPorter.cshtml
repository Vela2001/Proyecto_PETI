
@{
    ViewBag.Title = "AutodiagnosticoPorter";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil Competitivo - Fiel al Excel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f9fd;
        }

        .main-container {
            background-color: #fff;
            border: 1px solid #ccc;
            padding: 1.5rem;
        }

        .profile-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

            .profile-table th, .profile-table td {
                border: 1px solid #ddd;
                padding: 0.5rem;
                vertical-align: middle;
            }
        /* --- Cabecera de la tabla --- */
        .header-main {
            text-align: center;
            font-weight: bold;
            border: 1px solid #aaa;
        }

        .header-hostile {
            color: #dc3545;
        }

        .header-favorable {
            color: #0d6efd;
        }

        /* --- Estilos para las filas de criterios --- */
        .section-title-cell {
            background-color: #28a745; /* Verde */
            color: white;
            font-weight: bold;
            text-align: center;
            width: 20%;
        }

        .criterion-cell {
            background-color: #f2f2f2; /* Gris claro */
            font-weight: 500;
            text-align: left;
            padding-left: 1.5rem;
        }

        .hostile-label-cell {
            color: #dc3545; /* Rojo */
            font-weight: bold;
            text-align: right;
            width: 10%;
        }

        .favorable-label-cell {
            color: #0d6efd; /* Azul */
            font-weight: bold;
            text-align: left;
            width: 10%;
        }

        /* --- Estilos para el grid de selección --- */
        .selectable-cell {
            text-align: center;
            width: 5%; /* Ancho de cada celda de selección */
            border-left: 1px dotted #aaa;
            padding: 0;
        }

            .selectable-cell input[type="radio"] {
                display: none; /* Ocultamos el radio button */
            }

            .selectable-cell label {
                display: block;
                width: 100%;
                height: 35px; /* Altura de la celda clickeable */
                cursor: pointer;
                position: relative;
            }
                /* La 'x' se crea con un pseudo-elemento */
                .selectable-cell label::after {
                    content: 'x';
                    font-size: 1.2rem;
                    font-weight: normal;
                    color: transparent; /* Oculta por defecto */
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                }
            /* Estilo para la 'x' cuando se selecciona una opción */
            .selectable-cell input[type="radio"]:checked + label::after {
                color: #28a745; /* 'x' de color verde */
            }
        /* === CSS ADICIONAL PARA LA FILA DE CONCLUSIÓN === */

        .conclusion-label-cell {
            text-align: center;
            font-weight: bold;
            vertical-align: middle;
            color: #0d6efd; /* Azul, como en la imagen */
        }

        .conclusion-textarea-cell {
            padding: 1rem;
        }

        .conclusion-total-cell {
            text-align: center;
            vertical-align: middle;
            font-weight: bold;
            width: 8%; /* Ancho para la celda del total */
        }
        /* === CSS ADICIONAL PARA LA SECCIÓN FINAL === */

        .info-box {
            background-color: #eaf3f2; /* Un verde muy pálido */
            border: 1px solid #cce0de;
            padding: 1rem;
            border-radius: 0.25rem;
            font-size: 0.9rem;
        }

        .table-oportunidades thead th {
            background-color: #ffe8d1; /* Naranja pálido */
            text-align: center;
            font-weight: bold;
            border-color: #f7d4b6;
        }

        .table-amenazas thead th {
            background-color: #d1e7ff; /* Azul pálido de Bootstrap */
            text-align: center;
            font-weight: bold;
            border-color: #b8d6f8;
        }

        .table-oportunidades, .table-amenazas {
            border-color: #ccc;
        }

        .label-cell {
            width: 60px;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
        }

        /* Estilo para los botones de navegación como en la imagen */
        .btn-nav-porter {
            background-color: #008b8b; /* Un color teal/turquesa oscuro */
            color: white;
            font-weight: bold;
            padding: 0.5rem 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: all 0.2s ease-in-out;
        }

            .btn-nav-porter:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 8px rgba(0,0,0,0.15);
            }

            .btn-nav-porter i {
                font-size: 1.2rem;
                vertical-align: middle;
            }
        /* === CSS ADICIONAL PARA EL ENCABEZADO DE PÁGINA === */

        .btn-indice {
            background-color: #d9534f; /* Un rojo similar al de la imagen */
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            border: 2px solid #b54541;
            border-radius: 0.3rem;
            padding: 0.5rem 2rem;
            box-shadow: 0 3px 5px rgba(0,0,0,0.1);
        }

            .btn-indice:hover {
                background-color: #c9302c;
                border-color: #ac2925;
                color: white;
            }

        .intro-box {
            background-color: #e9eff3; /* Un azul-gris muy pálido */
            border: 1px solid #d8dde1;
            padding: 1rem;
            font-size: 0.9rem;
            border-radius: 0.25rem;
            margin-bottom: 2rem; /* Espacio antes de la tabla */
        }
    </style>
</head>
<body>

    <div class="container mt-4 mb-5">
        <div>
            <a href="#" class="btn btn-indice">INDICE</a>
        </div>

        <div class="intro-box mt-3">
            <p class="mb-0">
                A continuación marque con una X en las casillas que estime conveniente según el estado actual de su empresa. Valore su perfil competitivo en la escala Hostil-Favorable. Al finalizar lea la conclusión, para su caso particular, relativa al análisis del entorno próximo.
            </p>
        </div>
        <form id="perfilCompetitivoForm" action="#" method="post">
            <div class="main-container">

                <table class="profile-table">
                    <thead>
                        <tr>
                            <th class="header-main" colspan="2">PERFIL COMPETITIVO</th>
                            <th class="header-main header-hostile">Hostil</th>
                            <th class="header-main" colspan="6">
                                <div class="d-flex justify-content-around">
                                    <span>Nada</span><span>Poco</span><span>Medio</span><span>Alto</span><span>Muy Alto</span>
                                </div>
                            </th>
                            <th class="header-main header-favorable">Favorable</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th class="section-title-cell" rowspan="6">Rivalidad empresas del sector</th>
                            <th class="criterion-cell">- Crecimiento</th>
                            <td class="hostile-label-cell">Lento</td>
                            <td class="selectable-cell"><input type="radio" id="r1c1" name="rivalidad_crecimiento" value="1"><label for="r1c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r1c2" name="rivalidad_crecimiento" value="2"><label for="r1c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r1c3" name="rivalidad_crecimiento" value="3"><label for="r1c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r1c4" name="rivalidad_crecimiento" value="4"><label for="r1c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r1c5" name="rivalidad_crecimiento" value="5"><label for="r1c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r1c6" name="rivalidad_crecimiento" value="6"><label for="r1c6"></label></td>
                            <td class="favorable-label-cell">Rápido</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Naturaleza de los competidores</th>
                            <td class="hostile-label-cell">Muchos</td>
                            <td class="selectable-cell"><input type="radio" id="r2c1" name="rivalidad_naturaleza" value="1"><label for="r2c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r2c2" name="rivalidad_naturaleza" value="2"><label for="r2c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r2c3" name="rivalidad_naturaleza" value="3"><label for="r2c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r2c4" name="rivalidad_naturaleza" value="4"><label for="r2c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r2c5" name="rivalidad_naturaleza" value="5"><label for="r2c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r2c6" name="rivalidad_naturaleza" value="6"><label for="r2c6"></label></td>
                            <td class="favorable-label-cell">Pocos</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Exceso de capacidad productiva</th>
                            <td class="hostile-label-cell">Si</td>
                            <td class="selectable-cell"><input type="radio" id="r3c1" name="rivalidad_exceso_capacidad" value="1"><label for="r3c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r3c2" name="rivalidad_exceso_capacidad" value="2"><label for="r3c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r3c3" name="rivalidad_exceso_capacidad" value="3"><label for="r3c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r3c4" name="rivalidad_exceso_capacidad" value="4"><label for="r3c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r3c5" name="rivalidad_exceso_capacidad" value="5"><label for="r3c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r3c6" name="rivalidad_exceso_capacidad" value="6"><label for="r3c6"></label></td>
                            <td class="favorable-label-cell">No</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Rentabilidad media del sector</th>
                            <td class="hostile-label-cell">Baja</td>
                            <td class="selectable-cell"><input type="radio" id="r4c1" name="rivalidad_rentabilidad" value="1"><label for="r4c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r4c2" name="rivalidad_rentabilidad" value="2"><label for="r4c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r4c3" name="rivalidad_rentabilidad" value="3"><label for="r4c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r4c4" name="rivalidad_rentabilidad" value="4"><label for="r4c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r4c5" name="rivalidad_rentabilidad" value="5"><label for="r4c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r4c6" name="rivalidad_rentabilidad" value="6"><label for="r4c6"></label></td>
                            <td class="favorable-label-cell">Alta</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Diferenciación del producto</th>
                            <td class="hostile-label-cell">Escasa</td>
                            <td class="selectable-cell"><input type="radio" id="r5c1" name="rivalidad_diferenciacion" value="1"><label for="r5c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r5c2" name="rivalidad_diferenciacion" value="2"><label for="r5c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r5c3" name="rivalidad_diferenciacion" value="3"><label for="r5c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r5c4" name="rivalidad_diferenciacion" value="4"><label for="r5c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r5c5" name="rivalidad_diferenciacion" value="5"><label for="r5c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r5c6" name="rivalidad_diferenciacion" value="6"><label for="r5c6"></label></td>
                            <td class="favorable-label-cell">Elevada</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Barreras de salida</th>
                            <td class="hostile-label-cell">Bajas</td>
                            <td class="selectable-cell"><input type="radio" id="r6c1" name="rivalidad_barreras_salida" value="1"><label for="r6c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r6c2" name="rivalidad_barreras_salida" value="2"><label for="r6c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r6c3" name="rivalidad_barreras_salida" value="3"><label for="r6c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r6c4" name="rivalidad_barreras_salida" value="4"><label for="r6c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r6c5" name="rivalidad_barreras_salida" value="5"><label for="r6c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="r6c6" name="rivalidad_barreras_salida" value="6"><label for="r6c6"></label></td>
                            <td class="favorable-label-cell">Altas</td>
                        </tr>

                        <tr>
                            <th class="section-title-cell" rowspan="6">Barreras de Entrada</th>
                            <th class="criterion-cell">- Economías de escala</th>
                            <td class="hostile-label-cell">No</td>
                            <td class="selectable-cell"><input type="radio" id="b1c1" name="barreras_escala" value="1"><label for="b1c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b1c2" name="barreras_escala" value="2"><label for="b1c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b1c3" name="barreras_escala" value="3"><label for="b1c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b1c4" name="barreras_escala" value="4"><label for="b1c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b1c5" name="barreras_escala" value="5"><label for="b1c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b1c6" name="barreras_escala" value="6"><label for="b1c6"></label></td>
                            <td class="favorable-label-cell">Sí</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Necesidad de capital</th>
                            <td class="hostile-label-cell">Bajas</td>
                            <td class="selectable-cell"><input type="radio" id="b2c1" name="barreras_capital" value="1"><label for="b2c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b2c2" name="barreras_capital" value="2"><label for="b2c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b2c3" name="barreras_capital" value="3"><label for="b2c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b2c4" name="barreras_capital" value="4"><label for="b2c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b2c5" name="barreras_capital" value="5"><label for="b2c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b2c6" name="barreras_capital" value="6"><label for="b2c6"></label></td>
                            <td class="favorable-label-cell">Altas</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Acceso a la tecnología</th>
                            <td class="hostile-label-cell">Fácil</td>
                            <td class="selectable-cell"><input type="radio" id="b3c1" name="barreras_tecnologia" value="1"><label for="b3c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b3c2" name="barreras_tecnologia" value="2"><label for="b3c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b3c3" name="barreras_tecnologia" value="3"><label for="b3c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b3c4" name="barreras_tecnologia" value="4"><label for="b3c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b3c5" name="barreras_tecnologia" value="5"><label for="b3c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b3c6" name="barreras_tecnologia" value="6"><label for="b3c6"></label></td>
                            <td class="favorable-label-cell">Difícil</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Reglamentos o leyes limitativos</th>
                            <td class="hostile-label-cell">No</td>
                            <td class="selectable-cell"><input type="radio" id="b4c1" name="barreras_leyes" value="1"><label for="b4c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b4c2" name="barreras_leyes" value="2"><label for="b4c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b4c3" name="barreras_leyes" value="3"><label for="b4c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b4c4" name="barreras_leyes" value="4"><label for="b4c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b4c5" name="barreras_leyes" value="5"><label for="b4c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b4c6" name="barreras_leyes" value="6"><label for="b4c6"></label></td>
                            <td class="favorable-label-cell">Sí</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Trámites burocráticos</th>
                            <td class="hostile-label-cell">No</td>
                            <td class="selectable-cell"><input type="radio" id="b5c1" name="barreras_tramites" value="1"><label for="b5c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b5c2" name="barreras_tramites" value="2"><label for="b5c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b5c3" name="barreras_tramites" value="3"><label for="b5c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b5c4" name="barreras_tramites" value="4"><label for="b5c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b5c5" name="barreras_tramites" value="5"><label for="b5c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b5c6" name="barreras_tramites" value="6"><label for="b5c6"></label></td>
                            <td class="favorable-label-cell">Sí</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Reacción esperada actuales competidores</th>
                            <td class="hostile-label-cell">Escasa</td>
                            <td class="selectable-cell"><input type="radio" id="b6c1" name="barreras_reaccion" value="1"><label for="b6c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b6c2" name="barreras_reaccion" value="2"><label for="b6c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b6c3" name="barreras_reaccion" value="3"><label for="b6c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b6c4" name="barreras_reaccion" value="4"><label for="b6c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b6c5" name="barreras_reaccion" value="5"><label for="b6c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="b6c6" name="barreras_reaccion" value="6"><label for="b6c6"></label></td>
                            <td class="favorable-label-cell">Enérgica</td>
                        </tr>

                        <tr>
                            <th class="section-title-cell" rowspan="4">Poder de los Clientes</th>
                            <th class="criterion-cell">- Número de clientes</th>
                            <td class="hostile-label-cell">Pocos</td>
                            <td class="selectable-cell"><input type="radio" id="pc1c1" name="clientes_numero" value="1"><label for="pc1c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc1c2" name="clientes_numero" value="2"><label for="pc1c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc1c3" name="clientes_numero" value="3"><label for="pc1c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc1c4" name="clientes_numero" value="4"><label for="pc1c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc1c5" name="clientes_numero" value="5"><label for="pc1c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc1c6" name="clientes_numero" value="6"><label for="pc1c6"></label></td>
                            <td class="favorable-label-cell">Muchos</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Posibilidad de integración ascendente</th>
                            <td class="hostile-label-cell">Pequeña</td>
                            <td class="selectable-cell"><input type="radio" id="pc2c1" name="clientes_integracion" value="1"><label for="pc2c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc2c2" name="clientes_integracion" value="2"><label for="pc2c2"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc2c3" name="clientes_integracion" value="3"><label for="pc2c3"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc2c4" name="clientes_integracion" value="4"><label for="pc2c4"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc2c5" name="clientes_integracion" value="5"><label for="pc2c5"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc2c6" name="clientes_integracion" value="6"><label for="pc2c6"></label></td>
                            <td class="favorable-label-cell">Grande</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Rentabilidad de los clientes</th>
                            <td class="hostile-label-cell">Baja</td>
                            <td class="selectable-cell"><input type="radio" id="pc3c1" name="clientes_rentabilidad" value="1"><label for="pc3c1"></label></td>
                            <td class="selectable-cell"><input type="radio" id="pc3c2" name="clientes_rentabilidad" value="2"><label for="pc3c2"></label></td>
