@model proyecto_peti.ViewModel.PerfilCompetitivoViewModel
@{
    ViewBag.Title = "AutodiagnosticoPorter";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil Competitivo - Fiel al Excel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f4f9fd;
        }

        .main-container {
            background-color: #fff;
            border: 1px solid #ccc;
            padding: 1.5rem;
        }

        .profile-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

            .profile-table th, .profile-table td {
                border: 1px solid #ddd;
                padding: 0.5rem;
                vertical-align: middle;
            }
        /* --- Cabecera de la tabla --- */
        .header-main {
            text-align: center;
            font-weight: bold;
            border: 1px solid #aaa;
        }

        .header-hostile {
            color: #dc3545;
        }

        .header-favorable {
            color: #0d6efd;
        }

        /* --- Estilos para las filas de criterios --- */
        .section-title-cell {
            background-color: #28a745; /* Verde */
            color: white;
            font-weight: bold;
            text-align: center;
            width: 20%;
        }

        .criterion-cell {
            background-color: #f2f2f2; /* Gris claro */
            font-weight: 500;
            text-align: left;
            padding-left: 1.5rem;
        }

        .hostile-label-cell {
            color: #dc3545; /* Rojo */
            font-weight: bold;
            text-align: right;
            width: 10%;
        }

        .favorable-label-cell {
            color: #0d6efd; /* Azul */
            font-weight: bold;
            text-align: left;
            width: 10%;
        }

        /* --- Estilos para el grid de selección --- */
        .selectable-cell {
            text-align: center;
            width: 5%; /* Ancho de cada celda de selección */
            border-left: 1px dotted #aaa;
            padding: 0;
        }

            .selectable-cell input[type="radio"] {
                display: none; /* Ocultamos el radio button */
            }

            .selectable-cell label {
                display: block;
                width: 100%;
                height: 35px; /* Altura de la celda clickeable */
                cursor: pointer;
                position: relative;
            }
                /* La 'x' se crea con un pseudo-elemento */
                .selectable-cell label::after {
                    content: 'x';
                    font-size: 1.2rem;
                    font-weight: normal;
                    color: transparent; /* Oculta por defecto */
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    transform: translate(-50%, -50%);
                }
            /* Estilo para la 'x' cuando se selecciona una opción */
            .selectable-cell input[type="radio"]:checked + label::after {
                color: #28a745; /* 'x' de color verde */
            }
        /* === CSS ADICIONAL PARA LA FILA DE CONCLUSIÓN === */

        .conclusion-label-cell {
            text-align: center;
            font-weight: bold;
            vertical-align: middle;
            color: #0d6efd; /* Azul, como en la imagen */
        }

        .conclusion-textarea-cell {
            padding: 1rem;
        }

        .conclusion-total-cell {
            text-align: center;
            vertical-align: middle;
            font-weight: bold;
            width: 8%; /* Ancho para la celda del total */
        }
        /* === CSS ADICIONAL PARA LA SECCIÓN FINAL === */

        .info-box {
            background-color: #eaf3f2; /* Un verde muy pálido */
            border: 1px solid #cce0de;
            padding: 1rem;
            border-radius: 0.25rem;
            font-size: 0.9rem;
        }

        .table-oportunidades thead th {
            background-color: #ffe8d1; /* Naranja pálido */
            text-align: center;
            font-weight: bold;
            border-color: #f7d4b6;
        }

        .table-amenazas thead th {
            background-color: #d1e7ff; /* Azul pálido de Bootstrap */
            text-align: center;
            font-weight: bold;
            border-color: #b8d6f8;
        }

        .table-oportunidades, .table-amenazas {
            border-color: #ccc;
        }

        .label-cell {
            width: 60px;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
        }

        /* Estilo para los botones de navegación como en la imagen */
        .btn-nav-porter {
            background-color: #008b8b; /* Un color teal/turquesa oscuro */
            color: white;
            font-weight: bold;
            padding: 0.5rem 1.5rem;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: all 0.2s ease-in-out;
        }

            .btn-nav-porter:hover {
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 8px rgba(0,0,0,0.15);
            }

            .btn-nav-porter i {
                font-size: 1.2rem;
                vertical-align: middle;
            }
        /* === CSS ADICIONAL PARA EL ENCABEZADO DE PÁGINA === */

        .btn-indice {
            background-color: #d9534f; /* Un rojo similar al de la imagen */
            color: white;
            font-weight: bold;
            text-transform: uppercase;
            border: 2px solid #b54541;
            border-radius: 0.3rem;
            padding: 0.5rem 2rem;
            box-shadow: 0 3px 5px rgba(0,0,0,0.1);
        }

            .btn-indice:hover {
                background-color: #c9302c;
                border-color: #ac2925;
                color: white;
            }

        .intro-box {
            background-color: #e9eff3; /* Un azul-gris muy pálido */
            border: 1px solid #d8dde1;
            padding: 1rem;
            font-size: 0.9rem;
            border-radius: 0.25rem;
            margin-bottom: 2rem; /* Espacio antes de la tabla */
        }
    </style>
</head>
<body>

    <div class="container mt-4 mb-5">
        <div>
            <a href="@Url.Action("Index", "Menu")" class="btn btn-indice">INDICE</a>
        </div>

        <div class="intro-box mt-3">
            <p class="mb-0">
                A continuación marque con una X en las casillas que estime conveniente según el estado actual de su empresa. Valore su perfil competitivo en la escala Hostil-Favorable. Al finalizar lea la conclusión, para su caso particular, relativa al análisis del entorno próximo.
            </p>
        </div>
        <form id="perfilCompetitivoForm" action="@Url.Action("GuardarPerfilCompetitivo", "Porter")" method="post">
            <div class="main-container">

                <table class="profile-table">
                    <thead>
                        <tr>
                            <th class="header-main" colspan="2">PERFIL COMPETITIVO</th>
                            <th class="header-main header-hostile">Hostil</th>
                            <th class="header-main" colspan="6">
                                <div class="d-flex justify-content-around">
                                    <span>Nada</span><span>Poco</span><span>Medio</span><span>Alto</span><span>Muy Alto</span>
                                </div>
                            </th>
                            <th class="header-main header-favorable">Favorable</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th class="section-title-cell" rowspan="6">Rivalidad empresas del sector</th>
                            <th class="criterion-cell">- Crecimiento</th>
                            <td class="hostile-label-cell">Lento</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio"
                                           id=@($"r1c"+i)
                                           name="rivalidad_crecimiento"
                                           value="@i"
                                           @(Model.rivalidad_crecimiento == i ? "checked" : "") />
                                    <label for=@($"r1c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Rápido</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Naturaleza de los competidores</th>
                            <td class="hostile-label-cell">Muchos</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio"
                                           id=@($"r2c"+i)
                                           name="rivalidad_naturaleza"
                                           value="@i"
                                           @if (Model.rivalidad_naturaleza == i) { <text>checked="checked"</text>; } />
                                    <label for=@($"r2c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Pocos</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Exceso de capacidad productiva</th>
                            <td class="hostile-label-cell">Sí</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"r3c"+i) name="rivalidad_exceso_capacidad" value="@i" @(Model.rivalidad_exceso_capacidad == i ? "checked" : "") />
                                    <label for=@($"r3c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">No</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Rentabilidad media del sector</th>
                            <td class="hostile-label-cell">Baja</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"r4c"+i) name="rivalidad_rentabilidad" value="@i" @(Model.rivalidad_rentabilidad == i ? "checked" : "") />
                                    <label for=@($"r4c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Alta</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Diferenciación del producto</th>
                            <td class="hostile-label-cell">Escasa</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id="@($"r5c"+i)" name="rivalidad_diferenciacion" value="@i" @(Model.rivalidad_diferenciacion == i ? "checked" : "") />
                                    <label for="@($"r5c"+i)"></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Elevada</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Barreras de salida</th>
                            <td class="hostile-label-cell">Bajas</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"r6c"+i) name="rivalidad_barreras_salida" value="@i" @(Model.rivalidad_barreras_salida == i ? "checked" : "") />
                                    <label for=@($"r6c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Altas</td>
                        </tr>
                        <tr>
                            <th class="section-title-cell" rowspan="6">Barreras de Entrada</th>
                            <th class="criterion-cell">- Economías de escala</th>
                            <td class="hostile-label-cell">No</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b1c"+i) name="barreras_escala" value="@i" @(Model.barreras_escala == i ? "checked" : "") />
                                    <label for=@($"b1c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Sí</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Necesidad de capital</th>
                            <td class="hostile-label-cell">Bajas</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b2c"+i) name="barreras_capital" value="@i" @(Model.barreras_capital == i ? "checked" : "") />
                                    <label for=@($"b2c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Altas</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Acceso a la tecnología</th>
                            <td class="hostile-label-cell">Fácil</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b3c"+i) name="barreras_tecnologia" value="@i" @(Model.barreras_tecnologia == i ? "checked" : "") />
                                    <label for=@($"b3c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Difícil</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Reglamentos o leyes limitativos</th>
                            <td class="hostile-label-cell">No</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b4c"+i) name="barreras_leyes" value="@i" @(Model.barreras_leyes == i ? "checked" : "") />
                                    <label for=@($"b4c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Sí</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Trámites burocráticos</th>
                            <td class="hostile-label-cell">No</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b5c"+i) name="barreras_tramites" value="@i" @(Model.barreras_tramites == i ? "checked" : "") />
                                    <label for=@($"b5c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Sí</td>
                        </tr>

                        <tr>
                            <th class="criterion-cell">- Reacción esperada actuales competidores</th>
                            <td class="hostile-label-cell">Escasa</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"b6c"+i) name="barreras_reaccion" value="@i" @(Model.barreras_reaccion == i ? "checked" : "") />
                                    <label for=@($"b6c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Enérgica</td>
                        </tr>

                        <tr>
                            <th class="section-title-cell" rowspan="4">Poder de los Clientes</th>
                            <th class="criterion-cell">- Número de clientes</th>
                            <td class="hostile-label-cell">Pocos</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id="@($"pc1c"+i)" name="clientes_numero" value="@i" @(Model.clientes_numero == i ? "checked" : "") />
                                    <label for="@($"pc1c"+i)"></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Muchos</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Posibilidad de integración ascendente</th>
                            <td class="hostile-label-cell">Pequeña</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id="@($"pc2c"+i)" name="clientes_integracion" value="@i" @(Model.clientes_integracion == i ? "checked" : "") />
                                    <label for="@($"pc2c"+i)"></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Grande</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Rentabilidad de los clientes</th>
                            <td class="hostile-label-cell">Baja</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id="@($"pc3c"+i)" name="clientes_rentabilidad" value="@i" @(Model.clientes_rentabilidad == i ? "checked" : "") />
                                    <label for="@($"pc3c"+i)"></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Alta</td>
                        </tr>
                        <tr>
                            <th class="criterion-cell">- Coste de cambio de proveedor para cliente</th>
                            <td class="hostile-label-cell">Bajo</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id="@($"pc4c"+i)" name="clientes_coste_cambio" value="@i" @(Model.clientes_coste_cambio == i ? "checked" : "") />
                                    <label for="@($"pc4c"+i)"></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Alto</td>
                        </tr>

                        <tr>
                            <th class="section-title-cell" rowspan="1">Productos sustitutivos</th>
                            <th class="criterion-cell">- Disponibilidad de Productos Sustitutivos</th>
                            <td class="hostile-label-cell">Grande</td>
                            @for (int i = 1; i <= 6; i++)
                            {
                                <td class="selectable-cell">
                                    <input type="radio" id=@($"ps1c"+i) name="sustitutos_disponibilidad" value="@i" @(Model.sustitutos_disponibilidad == i ? "checked" : "") />
                                    <label for=@($"ps1c"+i)></label>
                                </td>
                            }
                            <td class="favorable-label-cell">Pequeña</td>
                        </tr>

                        <tr>
                            <td class="conclusion-label-cell" colspan="2">CONCLUSIÓN</td>
                            <td class="conclusion-textarea-cell" colspan="8">
                                <textarea name="conclusion" class="form-control" rows="3">> Estamos en un mercado altamente competitivo, en el que es muy difícil hacerse un hueco en el mercado.</textarea>
                            </td>
                            <td class="conclusion-total-cell">
                                <div class="fw-bold">Total</div>
                                <div id="totalScore" class="fs-2 fw-bold">0</div>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
            <div class="main-container mt-4">
                <div class="info-box">
                    <p class="mb-0">
                        Una vez analizado el entorno próximo de su empresa, es decir análisis externo de su microentorno, identifique las
                        oportunidades y amenazas más relevantes que desee que se reflejen en el análisis FODA de su Plan Estratégico.
                    </p>
                </div>

                <table class="table table-bordered mt-4 table-oportunidades">
                    <thead>
                        <tr>
                            <th colspan="2">OPORTUNIDADES</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="label-cell">O1:</td>
                            <td><input type="text" name="oportunidad1" class="form-control border-0" value="@Model.oportunidad1" /></td>
                        </tr>
                        <tr>
                            <td class="label-cell">O2:</td>
                            <td><input type="text" name="oportunidad2" class="form-control border-0" value="@Model.oportunidad2" /></td>
                        </tr>
                    </tbody>
                </table>

                <table class="table table-bordered mt-4 table-amenazas">
                    <thead>
                        <tr>
                            <th colspan="2">AMENAZAS</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="label-cell">A1:</td>
                            <td><input type="text" name="amenaza1" class="form-control border-0" value="@Model.amenaza1" /></td>
                        </tr>
                        <tr>
                            <td class="label-cell">A2:</td>
                            <td><input type="text" name="amenaza2" class="form-control border-0" value="@Model.amenaza2" /></td>
                        </tr>
                    </tbody>
                </table>



            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Guardar Perfil Competitivo
                </button>
            </div>


            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Index", "Porter")" class="btn btn-nav-porter">
                    <i class="fas fa-chevron-circle-left"></i> 8. ANÁLISIS PORTER
                </a>
                <a href="@Url.Action("Index", "AnalisisPEST")" class="btn btn-nav-porter">
                    9. PEST <i class="fas fa-chevron-circle-right"></i>
                </a>
            </div>


        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('autodiagnosticoPorterForm');
            const totalScoreElement = document.getElementById('totalScore');

            function calculateTotal() {
                let total = 0;
                // Seleccionamos todos los radio buttons que estén marcados
                const checkedRadios = form.querySelectorAll('input[type="radio"]:checked');

                checkedRadios.forEach(radio => {
                    total += parseInt(radio.value, 10);
                });

                totalScoreElement.textContent = total;
            }

            // Añadimos un listener al formulario. Cada vez que algo cambie, recalculamos.
            form.addEventListener('change', calculateTotal);

            // Calculamos el total inicial al cargar la página (será 0)
            calculateTotal();
        });
    </script>

</body>
</html>

