    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('autodiagnosticoPorterForm');
            const totalScoreElement = document.getElementById('totalScore');

            function calculateTotal() {
                let total = 0;
                // Seleccionamos todos los radio buttons que estén marcados
                const checkedRadios = form.querySelectorAll('input[type="radio"]:checked');

                checkedRadios.forEach(radio => {
                    total += parseInt(radio.value, 10);
                });

                totalScoreElement.textContent = total;
            }

            // Añadimos un listener al formulario. Cada vez que algo cambie, recalculamos.
            form.addEventListener('change', calculateTotal);

            // Calculamos el total inicial al cargar la página (será 0)
            calculateTotal();
        });
    </script>

