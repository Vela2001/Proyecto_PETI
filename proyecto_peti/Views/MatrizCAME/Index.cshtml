@{
    ViewBag.Title = "Matriz CAME";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(to right, #e3f2fd, #fce4ec);
    }

    .card-came {
        background-color: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        padding: 2rem;
        margin-top: 2rem;
    }

    .title-came {
        background: linear-gradient(to right, #3f51b5, #2196f3);
        color: white;
        padding: 1rem 2rem;
        border-radius: 15px;
        text-align: center;
        font-size: 2rem;
        font-weight: 700;
        box-shadow: 0 6px 16px rgba(0,0,0,0.15);
        margin-bottom: 2rem;
    }

    .description {
        text-align: center;
        font-size: 1.1rem;
        color: #333;
        margin-bottom: 1rem;
    }

    .highlight {
        background-color: #f5f5f5;
        padding: 1rem;
        border-left: 5px solid #3f51b5;
        border-radius: 10px;
        font-size: 1rem;
        margin: 1.5rem 0;
        text-align: center;
    }

    .came-table thead {
        background-color: #e3f2fd;
        font-weight: bold;
        text-align: center;
    }

    .came-table td, .came-table th {
        vertical-align: middle !important;
    }

    .came-section {
        font-size: 1.2rem;
        font-weight: bold;
        color: white;
        text-align: center;
    }

    .section-c { background-color: #42a5f5; }
    .section-a { background-color: #ef5350; }
    .section-m { background-color: #66bb6a; }
    .section-e { background-color: #ab47bc; }

    textarea.form-control {
        resize: none;
        border-radius: 10px;
        transition: 0.3s;
    }

    textarea.form-control:focus {
        box-shadow: 0 0 0 3px rgba(63, 81, 181, 0.2);
        border-color: #3f51b5;
    }

    .btn-came {
        font-size: 1rem;
        padding: 0.75rem 1.5rem;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-came:hover {
        transform: scale(1.05);
        opacity: 0.9;
    }

    .btn-save { background-color: #4caf50; color: white; border: none; }
    .btn-prev { background-color: #9e9e9e; color: white; border: none; }
    .btn-next { background-color: #3f51b5; color: white; border: none; }

    .media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 1rem;
        }
    }
</style>

<div class="container">
    <div class="card-came">
        <div class="title-came">11. MATRIZ CAME</div>

        <p class="description">
            Para ejecutar con éxito la estrategia, identifique acciones específicas para:
            <strong>Corregir debilidades</strong>, <strong>Afrontar amenazas</strong>,
            <strong>Mantener fortalezas</strong> y <strong>Explotar oportunidades</strong>.
        </p>
        <div style="text-align: center;">
            <img src="~/Content/img/CAME.png" alt="Matriz came" style="width: 100%; max-width: 700px; border-radius: 12px; margin-top: 2rem;" />
        </div>

        <div class="highlight">
            💡 <strong>Recomendación:</strong> Sea concreto. Estas acciones deben tener impacto directo en la implementación estratégica.
        </div>

        <form method="post">
            <div class="table-responsive">
                <table class="table table-bordered came-table">
                    <thead>
                        <tr>
                            <th style="width: 8%">Tipo</th>
                            <th style="width: 8%">#</th>
                            <th>Acción Estratégica</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- C -->
                        <tr class="section-c"><td rowspan="4" class="came-section">C</td><td>1</td><td><textarea name="Corregir1" class="form-control"></textarea></td></tr>
                        <tr><td>2</td><td><textarea name="Corregir2" class="form-control"></textarea></td></tr>
                        <tr><td>3</td><td><textarea name="Corregir3" class="form-control"></textarea></td></tr>
                        <tr><td>4</td><td><textarea name="Corregir4" class="form-control"></textarea></td></tr>

                        <!-- A -->
                        <tr class="section-a"><td rowspan="4" class="came-section">A</td><td>5</td><td><textarea name="Afrontar1" class="form-control"></textarea></td></tr>
                        <tr><td>6</td><td><textarea name="Afrontar2" class="form-control"></textarea></td></tr>
                        <tr><td>7</td><td><textarea name="Afrontar3" class="form-control"></textarea></td></tr>
                        <tr><td>8</td><td><textarea name="Afrontar4" class="form-control"></textarea></td></tr>

                        <!-- M -->
                        <tr class="section-m"><td rowspan="4" class="came-section">M</td><td>9</td><td><textarea name="Mantener1" class="form-control"></textarea></td></tr>
                        <tr><td>10</td><td><textarea name="Mantener2" class="form-control"></textarea></td></tr>
                        <tr><td>11</td><td><textarea name="Mantener3" class="form-control"></textarea></td></tr>
                        <tr><td>12</td><td><textarea name="Mantener4" class="form-control"></textarea></td></tr>

                        <!-- E -->
                        <tr class="section-e"><td rowspan="4" class="came-section">E</td><td>13</td><td><textarea name="Explotar1" class="form-control"></textarea></td></tr>
                        <tr><td>14</td><td><textarea name="Explotar2" class="form-control"></textarea></td></tr>
                        <tr><td>15</td><td><textarea name="Explotar3" class="form-control"></textarea></td></tr>
                        <tr><td>16</td><td><textarea name="Explotar4" class="form-control"></textarea></td></tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="@Url.Action("Index", "IdentificacionEstrategias")" class="btn-came btn-prev">
                    🔙 IDENTIFICACIÓN DE ESTRATEGIAS
                </a>
                <button type="submit" class="btn-came btn-save">
                    💾 GUARDAR MATRIZ CAME
                </button>
                <a href="@Url.Action("Index", "Resumen")" class="btn-came btn-next">
                    RESUMEN EJECUTIVO 🔜
                </a>
            </div>
        </form>
    </div>
</div>
