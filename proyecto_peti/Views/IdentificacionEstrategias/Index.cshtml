    <script>
        function actualizarTotales(cellClass, totalIdPrefix) {
            for (let col = 1; col <= 4; col++) {
                let total = 0;
                document.querySelectorAll(`.${cellClass}[data-col='${col}']`).forEach(input => {
                    const val = parseInt(input.value) || 0;
                    total += val;
                });
                document.getElementById(`${totalIdPrefix}-total-col-${col}`).textContent = total;
            }
        }

        function calcularPuntajes(cellClass, outputId) {
            let total = 0;
            document.querySelectorAll('.' + cellClass).forEach(input => {
                const val = parseInt(input.value) || 0;
                total += val;
            });
            document.getElementById(outputId).value = total;
        }

        function actualizarTodo() {
            actualizarTotales('fo-cell', 'fo');
            actualizarTotales('fa-cell', 'fa');
            actualizarTotales('do-cell', 'do');
            actualizarTotales('da-cell', 'da');

            calcularPuntajes('fo-cell', 'PuntajeFO');
            calcularPuntajes('fa-cell', 'PuntajeFA');
            calcularPuntajes('do-cell', 'PuntajeDO');
            calcularPuntajes('da-cell', 'PuntajeDA');
        }

        // Añadir el 'listener' a todos los inputs de las celdas
        document.querySelectorAll('.fo-cell, .fa-cell, .do-cell, .da-cell').forEach(input => {
            input.addEventListener('input', actualizarTodo);
        });

        // Ejecutar una vez al cargar la página para inicializar los totales en 0
        document.addEventListener('DOMContentLoaded', (event) => {
            actualizarTodo();
        });
    </script>

