@model proyecto_peti.Models.InformacionEmpresa
@{
    ViewBag.Title = "Información de la Empresa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --primary-color: #3f51b5;
        --secondary-color: #6c757d;
        --success-color: #28a745;
        --info-color: #17a2b8;
        --light-bg: #f8f9fa;
    }

    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: none;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-color), #2196f3);
        color: white;
        padding: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-align: center;
        border-bottom: none;
        margin: -1.5rem -1.5rem 2rem -1.5rem;
    }

    .intro-text {
        color: #495057;
        line-height: 1.7;
        margin-bottom: 2rem;
        font-size: 1.1rem;
    }

    .example-box {
        background-color: var(--light-bg);
        border-left: 4px solid var(--info-color);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .example-title {
        color: var(--primary-color);
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
    }

        .example-title i {
            margin-right: 0.5rem;
        }

    .company-example {
        background-color: white;
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

        .company-example:last-child {
            margin-bottom: 0;
        }

    .company-name {
        color: var(--primary-color);
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .form-label {
        font-weight: 600;
        color: var(--primary-color);
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control {
        border-radius: 8px;
        padding: 1rem;
        font-size: 1rem;
        border: 1px solid #ced4da;
        transition: all 0.3s;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(63, 81, 181, 0.25);
        }

    .btn {
        font-weight: 600;
        padding: 0.75rem 1.75rem;
        border-radius: 30px;
        transition: all 0.3s;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border: none;
        letter-spacing: 0.5px;
    }

    .btn-secondary {
        background-color: var(--secondary-color);
    }

        .btn-secondary:hover {
            background-color: #5a6268;
            transform: translateY(-2px);
        }

    .btn-success {
        background: linear-gradient(135deg, var(--success-color), #20c997);
    }

        .btn-success:hover {
            background: linear-gradient(135deg, #218838, #1aa179);
            transform: translateY(-2px);
        }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-color), #17a2b8);
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #0069d9, #138496);
            transform: translateY(-2px);
        }

    .navigation-buttons {
        display: flex;
        justify-content: space-between;
        margin-top: 2rem;
        gap: 1rem;
    }

    .resource-link {
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
        display: inline-block;
        margin-top: 0.5rem;
    }

        .resource-link:hover {
            color: #1e3a8a;
            text-decoration: underline;
            transform: translateX(5px);
        }

        .resource-link i {
            margin-right: 0.5rem;
        }
    .descripcion-horizontal {
        min-width: 100%;
        max-width: 100%;
        resize: vertical;
    }
</style>

<div class="container mt-4">
    <div class="card p-4">
        <div class="card-header">
            <h2 class="mb-0">INFORMACIÓN DE LA EMPRESA</h2>
        </div>
        <div style="text-align: center;">
            <img src="~/Content/img/empresa.jpg" alt="empresa" style="width: 100%; max-width: 700px; border-radius: 12px; margin-top: 2rem;" />
        </div>

        <div class="card-body">
            <div class="intro-text">
                <p>
                    El <strong>Plan Estratégico de Tecnologías de la Información (PETI)</strong> es un instrumento fundamental para gestionar eficientemente los recursos tecnológicos de su organización.
                    Permite alinear la tecnología con los objetivos estratégicos del negocio, optimizando procesos y generando valor.
                </p>

                          </div>

            <div class="example-box">
                <div class="example-title">
                    <i class="fas fa-lightbulb"></i> EJEMPLOS DE EMPRESAS LÍDERES
                </div>

                <div class="company-example">
                    <div class="company-name">Apple Inc.</div>
                    <p>
                        Empresa tecnológica multinacional especializada en diseño y desarrollo de productos electrónicos, software y servicios.
                        Sus productos emblemáticos incluyen iPhone, iPad, Mac y Apple Watch, complementados con servicios como iCloud, Apple Music
                        y Apple Pay. Apple destaca por su ecosistema integrado y enfoque en experiencia del usuario.
                    </p>
                </div>

                <div class="company-example">
                    <div class="company-name">Amazon.com, Inc.</div>
                    <p>
                        Líder global en comercio electrónico y servicios en la nube. Más allá de su plataforma de ventas, ofrece servicios como
                        Amazon Web Services (AWS), dispositivos Echo con Alexa, y producciones originales a través de Amazon Studios. Su modelo
                        se basa en innovación constante y orientación al cliente.
                    </p>
                </div>

                <div class="company-example">
                    <div class="company-name">Tesla, Inc.</div>
                    <p>
                        Empresa pionera en vehículos eléctricos y energía sostenible. Fabrica automóviles eléctricos de alto rendimiento y desarrolla
                        tecnologías de baterías y energía solar. Su enfoque en conducción autónoma y sostenibilidad la posiciona como referente
                        en movilidad del futuro.
                    </p>
                </div>
            </div>

            @using (Html.BeginForm())
            {
                @Html.HiddenFor(m => m.PlanId)

                <div class="mb-4">
                    <label class="form-label">NOMBRE DE LA EMPRESA</label>
                    @Html.TextBoxFor(m => m.NombreEmpresa, new
                    {
                        @class = "form-control",
                        placeholder = "Ingrese el nombre legal de su organización"
                    })
                </div>

                <div class="mb-4">
                    <label class="form-label">DESCRIPCIÓN DE LA EMPRESA</label>
                    @Html.TextAreaFor(m => m.Descripcion, new
                    {
                        @class = "form-control descripcion-horizontal",
                        rows = "3",
                        @style = "width: 100%;",
                        placeholder = "Describa los principales productos/servicios, sector de operación, mercado objetivo y características distintivas de su empresa..."
                    })
                </div>


                <div class="navigation-buttons">
                    <a href="@Url.Action("Index", "Menu")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> VOLVER AL ÍNDICE
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save"></i> GUARDAR Y CONTINUAR
                    </button>
                    <a href="@Url.Action("Index", "Mision")" class="btn btn-primary">
                        SIGUIENTE: MISIÓN <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            }
        </div>

    </div>
</div>